# Set your time zone here (use "TZ identifier" from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List)
TIME_ZONE=
# Generate your own secret key for production deployments! (use single quotes)
DJANGO_SECRET_KEY=''
# Set to select a specific version of tabbycat
DOCKER_IMAGE_TAG=
# Set if using custom images or pushing to your own registry
DOCKER_IMAGE=
